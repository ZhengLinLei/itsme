# Copy this file to .env and adjust it. RUN.sh loads it automatically.

# --- Docker ---
IMAGE_NAME=itsme-api
IMAGE_TAG=latest
CONTAINER_NAME=itsme-api
HOST_PORT=3000

# --- API ---
PORT=3000
# If set, requests must include an Authorization header.
API_KEY=
CORS_ORIGIN=*
MAX_HISTORY=20
CONVERSATION_TTL_MIN=60

# --- LLM ---
# ollama (local, inside the container) | openai (any compatible API) | anthropic
LLM_PROVIDER=ollama
# Defaults: ollama -> qwen2.5:3b | openai -> gpt-4o-mini | anthropic -> claude-haiku-5-5
LLM_MODEL=qwen2.5:3b
# Empty = provider default (ollama: http://127.0.0.1:11434)
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=512
LLM_TIMEOUT_MS=120000
