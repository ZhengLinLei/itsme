# Copy this file to .env and adjust it. BUILD.sh and RUN.sh load it automatically.

# --- Docker ---
IMAGE_NAME=itsme-api
IMAGE_TAG=latest
CONTAINER_NAME=itsme-api
HOST_PORT=3000
OLLAMA_VERSION=latest

# --- API ---
PORT=3000

# --- Security ---
# Websites allowed to call the API from the browser (comma-separated, no trailing slash).
# Empty blocks every browser origin; "*" allows any website (not recommended in production).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Set to true only when running behind a reverse proxy (nginx, Traefik, Cloudflare...) so the
# real client IP is read from X-Forwarded-For. Otherwise clients could fake their IP.
TRUST_PROXY=false
# Optional shared key required on every route except /health. Only use it when the caller is
# your own backend: a key in browser code is public.
API_KEY=
# Enables admin routes (GET /api/context, GET /api/info). Never ship it to the browser.
ADMIN_API_KEY=
# Signs session tokens. When empty, one is generated and stored in the data volume.
SESSION_SECRET=
# Optional Cloudflare Turnstile secret: when set, creating a session requires a captcha token.
TURNSTILE_SECRET=

# --- Sessions ---
# A conversation is kept this many hours after its last message.
SESSION_TTL_HOURS=24
# Messages sent to the model as conversation history.
MAX_HISTORY=20
MAX_MESSAGES_PER_SESSION=200
MAX_SESSIONS=10000

# --- Rate limits and sizes ---
RATE_LIMIT_MESSAGES_PER_MIN=12
RATE_LIMIT_REQUESTS_PER_MIN=60
RATE_LIMIT_SESSIONS_PER_HOUR=20
MAX_MESSAGE_CHARS=2000
MAX_BODY_BYTES=16384
# LLM calls running at once, and how many may wait (more get HTTP 503).
LLM_CONCURRENCY=2
LLM_QUEUE=20
WS_MAX_CONNECTIONS_PER_IP=5
WS_IDLE_TIMEOUT_SEC=300

# --- LLM ---
# ollama (local, inside the container) | openai (any compatible API) | anthropic
LLM_PROVIDER=ollama
# Defaults: ollama -> qwen2.5:3b | openai -> gpt-4o-mini | anthropic -> claude-haiku-5-5
LLM_MODEL=qwen2.5:3b
# Empty = provider default (ollama: http://127.0.0.1:11434).
# On a Mac, use the native Ollama: http://host.docker.internal:11434
LLM_BASE_URL=
LLM_API_KEY=
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=512
LLM_TIMEOUT_MS=120000
